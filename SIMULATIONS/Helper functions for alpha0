  colnames(node_info_type2) = c("type", "block")
  true_labels_type2 = c(node_info_type2$block)
  
  ##### perform spectral clustering #####
  L_tilde = L_tau_sq + alpha * tcrossprod(X)
  
  V <- RSpectra::eigs_sym(L_tilde, T * K, "LM")$vectors
  
  V_type1 = V[1:(n / 2), ]
  V_type2 = V[((n / 2) + 1):n, ]
  
  # Apply k-means clustering to the eigenvectors
  k_means_output_type1 <- kmeans(
    V_type1, centers = K, iter.max = 1000, nstart = 100
  )
  
  k_means_output_type2 <- kmeans(
    V_type2, centers = K, iter.max = 1000, nstart = 100
  )
  
  predicted_label_type1 = k_means_output_type1$cluster
  predicted_label_type2 = k_means_output_type2$cluster
  
  ### type 1 ####
  E1 <- factor(predicted_label_type1, levels = 1:K)
  A <- table(E1, true_labels_type1)
  B <- diag(as.numeric(table(true_labels_type1)))
  A <- pMatrix.min(A, B)$A
  
  number_of_misclassified_type1 = sum(A) - sum(diag(A))
  
  ### type 2 ####
  E2 <- factor(predicted_label_type2, levels = 1:K)
  A <- table(E2, true_labels_type2)
  B <- diag(as.numeric(table(true_labels_type2)))
  A <- pMatrix.min(A, B)$A
  
  number_of_misclassified_type2 = sum(A) - sum(diag(A))
  
  return(list(number_of_misclassified_type1, number_of_misclassified_type2))
}


### homogeneous SBM ###
homogeneous_sbm <- function(r, n, K = 3) {
  
  ones_vector_K <- rep(1, K)
  one_matrix_K <- ones_vector_K %*% t(ones_vector_K)
  
  ### probability controlling parameters ###
  p1 = 0.2
  p2 = 0.2
  r1 = r
  r2 = r
  
  # Define the block probability matrices P11 and P22
  P11 <- as.matrix(p1 * one_matrix_K + r1 * diag(1, K), K, K)
  P22 <- as.matrix(p2 * one_matrix_K + r2 * diag(1, K), K, K)
  
  #########################################
  # Assume equal partitioning of nodes into K blocks for each type
  Z_type1 <- matrix(0, n / 2, K)
  Z_type2 <- matrix(0, n / 2, K)
  
  # Randomly assign each node to one of the K blocks for type-1
  for (i in 1:nrow(Z_type1)) {
    Z_type1[i, sample(1:K, 1)] <- 1
  }
  
  # Randomly assign each node to one of the K blocks for type-2
  for (i in 1:nrow(Z_type2)) {
    Z_type2[i, sample(1:K, 1)] <- 1
  }
  
  A1 = gen_adj(Z_type1, P11)
  A2 = gen_adj(Z_type2, P22)
  
  ##############################################################
  ## true labels ###
  true_labels_type1 = c()
  true_labels_type2 = c()
  
  for (i in 1:nrow(Z_type1)) {
    true_labels_type1[i] = which(Z_type1[i, ] == 1)
  }
  
  for (i in 1:nrow(Z_type2)) {
    true_labels_type2[i] = which(Z_type2[i, ] == 1)
  }
  
  L_tau1 = gen_regularized_laplacian(A1)
  L_tau2 = gen_regularized_laplacian(A2)
  
  V_type1 = get_eigenvector_matrix(L_tau1, K)
  V_type2 = get_eigenvector_matrix(L_tau2, K)
  
  predicted_label_type1 = kmeans(
    V_type1, centers = K, iter.max = 100, nstart = 20
  )$cluster
  
  predicted_label_type2 = kmeans(
    V_type2, centers = K, iter.max = 100, nstart = 20
  )$cluster
  
  ### type 1 ####
  E1 <- factor(predicted_label_type1, levels = 1:K)
  A <- table(E1, true_labels_type1)
  B <- diag(as.numeric(table(true_labels_type1)))
  A <- pMatrix.min(A, B)$A
  
  number_of_misclassified_type1 = sum(A) - sum(diag(A))
  
  ### type 2 ####
  E2 <- factor(predicted_label_type2, levels = 1:K)
  A <- table(E2, true_labels_type2)
  B <- diag(as.numeric(table(true_labels_type2)))
  A <- pMatrix.min(A, B)$A
  
  number_of_misclassified_type2 = sum(A) - sum(diag(A))
  
  return(list(number_of_misclassified_type1, number_of_misclassified_type2))
}


### homogeneous covariate SBM ###
homogeneous_cov_sbm <- function(d, r, n, K = 3, T = 2, R = 3) {
  
  ones_vector_K <- rep(1, K)
  one_matrix_K <- ones_vector_K %*% t(ones_vector_K)
  
  ### probability controlling parameters ###
  p1 = 0.2
  p2 = 0.2
  r1 = r
  r2 = r
  
  # Define the block probability matrices P11 and P22
  P11 <- as.matrix(p1 * one_matrix_K + r1 * diag(1, K), K, K)
  P22 <- as.matrix(p2 * one_matrix_K + r2 * diag(1, K), K, K)
  
  #########################################
  # Assume equal partitioning of nodes into K blocks for each type
  Z_type1 <- matrix(0, n / 2, K)
  Z_type2 <- matrix(0, n / 2, K)
  
  # Randomly assign each node to one of the K blocks for type-1
  for (i in 1:nrow(Z_type1)) {
    Z_type1[i, sample(1:K, 1)] <- 1
  }
  
  # Randomly assign each node to one of the K blocks for type-2
  for (i in 1:nrow(Z_type2)) {
    Z_type2[i, sample(1:K, 1)] <- 1
  }
  
  A1 = gen_adj(Z_type1, P11)
  A2 = gen_adj(Z_type2, P22)
  
  ##############################################################
  ## true labels ###
  true_labels_type1 = c()
  true_labels_type2 = c()
  
  for (i in 1:nrow(Z_type1)) {
    true_labels_type1[i] = which(Z_type1[i, ] == 1)
  }
  
  for (i in 1:nrow(Z_type2)) {
    true_labels_type2[i] = which(Z_type2[i, ] == 1)
  }
  
  L_tau1 = gen_regularized_laplacian(A1)
  L_tau2 = gen_regularized_laplacian(A2)
  
  ### covariate ######
  R = 3
  
  p_out_cov_type1 = 0.08
  p_out_cov_type2 = 0.05
  
  M_type1 <- as.matrix(
    p_out_cov_type1 * one_matrix_K + d * diag(1, K),
    nrow = T * K / 2, ncol = R
  )
  
  M_type2 <- as.matrix(
    p_out_cov_type2 * one_matrix_K + d * diag(1, K),
    nrow = T * K / 2, ncol = R
  )
  
  ### expected value of X given Z ###
  expected_X_type1 = Z_type1 %*% M_type1
  expected_X_type2 = Z_type2 %*% M_type2
  
  ### generate covariate matrix X ###
  X1 = matrix(
    rbinom(nrow(Z_type1) * R, 1, expected_X_type1),
    nrow = nrow(Z_type1), ncol = R
  )
  
  X2 = matrix(
    rbinom(nrow(Z_type2) * R, 1, expected_X_type2),
    nrow = nrow(Z_type2), ncol = R
  )
  
  optimal_alpha_type1 = (RSpectra::eigs_sym(L_tau1%*%L_tau1, k = 1, which = "LA")$values[1])/(RSpectra::eigs_sym(X1%*%t(X1), k = 1, which = "LA")$values[1])
  optimal_alpha_type2 = (RSpectra::eigs_sym(L_tau2%*%L_tau2, k = 1, which = "LA")$values[1])/(RSpectra::eigs_sym(X2%*%t(X2), k = 1, which = "LA")$values[1])
  
  ## prepare cov-assisted laplacians ###
  L_tilde1 = crossprod(L_tau1) + optimal_alpha_type1 * tcrossprod(X1)
  L_tilde2 = crossprod(L_tau2) + optimal_alpha_type2 * tcrossprod(X2)
  
  V1 = RSpectra::eigs_sym(L_tilde1, K, which = "LM")$vectors
  V2 = RSpectra::eigs_sym(L_tilde2, K, which = "LM")$vectors
  
  pred_labels_type1 = kmeans(
    V1, centers = K, iter.max = 100, nstart = 20
  )$cluster
  
  pred_labels_type2 = kmeans(
    V2, centers = K, iter.max = 100, nstart = 20
  )$cluster
  
  ### type 1 ####
  E1 <- factor(pred_labels_type1, levels = 1:K)
  A <- table(E1, true_labels_type1)
  B <- diag(as.numeric(table(true_labels_type1)))
  A <- pMatrix.min(A, B)$A
  
  number_of_misclassified_type1 = sum(A) - sum(diag(A))
  
  ### type 2 ####
  E2 <- factor(pred_labels_type2, levels = 1:K)
  A <- table(E2, true_labels_type2)
  B <- diag(as.numeric(table(true_labels_type2)))
  A <- pMatrix.min(A, B)$A
  
  number_of_misclassified_type2 = sum(A) - sum(diag(A))
  
  return(list(number_of_misclassified_type1, number_of_misclassified_type2))
}


### heterogeneous SBM ###
heterogeneous_sbm <- function(r, r3, n, K = 3, T = 2) {
  
  ones_vector_K <- rep(1, K)
  one_matrix_K <- ones_vector_K %*% t(ones_vector_K)
  
  ### probability controlling parameters ###
  p1 = 0.2
  p2 = 0.2
  r1 = r
  r2 = r
  p3 = 0.15
  
  # Define the block probability matrices P11, P12, P21, P22
  P11 <- as.matrix(p1 * one_matrix_K + r1 * diag(1, K), K, K)
  P12 <- as.matrix(p3 * one_matrix_K + r3 * diag(1, K), K, K)
  P22 <- as.matrix(p2 * one_matrix_K + r2 * diag(1, K), K, K)
  
  # Construct the full probability matrix P
  P <- rbind(
    cbind(P11, P12),
    cbind(t(P12), P22)
  )
  
  #########################################
  Z_type1 <- matrix(0, n / 2, K)
  Z_type2 <- matrix(0, n / 2, K)
  
  # Randomly assign each node to one of the K blocks
  for (i in 1:nrow(Z_type1)) {
    Z_type1[i, sample(1:K, 1)] <- 1
  }
  
  for (i in 1:nrow(Z_type2)) {
    Z_type2[i, sample(1:K, 1)] <- 1
  }
  
  zero_matrix = matrix(0, n / 2, K)
  
  Z_type1 = cbind(Z_type1, zero_matrix)
  Z_type2 = cbind(zero_matrix, Z_type2)
  
  # Combine type-1 and type-2 membership matrices
  Z <- rbind(Z_type1, Z_type2)
  
  ##############################################
  # Generate adjacency matrix A
  A = gen_adj(Z, P)
  
  ####################################################################
  # Create a vector to store ground truth node information
  node_info <- matrix(0, n, 2)
  
  for (i in 1:n) {
    
    # Type membership
    node_info[i, 1] <- ifelse(which(Z[i, ] == 1) <= (T * K / 2), 1, 2)
    
    # Block membership
    if (which(Z[i, ] == 1) %in% c(1, 4)) {
      node_info[i, 2] <- 1
    } else if (which(Z[i, ] == 1) %in% c(2, 5)) {
      node_info[i, 2] <- 2
    } else if (which(Z[i, ] == 1) %in% c(3, 6)) {
      node_info[i, 2] <- 3
    }
  }
  
  number_of_misclassified_type1_het = misclustering_error_rate_het(
    node_info = node_info, A = A, T = 2, K = K, n = n
  )[[1]]
  
  number_of_misclassified_type2_het = misclustering_error_rate_het(
    node_info = node_info, A = A, T = 2, K = K, n = n
  )[[2]]
  
  return(list(
    number_of_misclassified_type1_het,
    number_of_misclassified_type2_het
  ))
}


### heterogeneous covariate SBM ###
het_cov_sbm <- function(d, r, r3, n, K = 3, T = 2, R = 3) {
  
  ones_vector_K <- rep(1, K)
  one_matrix_K <- ones_vector_K %*% t(ones_vector_K)
  
  ### probability controlling parameters ###
  p1 = 0.2
  p2 = 0.2
  r1 = r
  r2 = r
  p3 = 0.15
  
  # Define the block probability matrices P11, P12, P21, P22
  P11 <- as.matrix(p1 * one_matrix_K + r1 * diag(1, K), K, K)
  P12 <- as.matrix(p3 * one_matrix_K + r3 * diag(1, K), K, K)
  P22 <- as.matrix(p2 * one_matrix_K + r2 * diag(1, K), K, K)
  
  # Construct the full probability matrix P
  P <- rbind(
    cbind(P11, P12),
    cbind(t(P12), P22)
  )
  
  #########################################
  Z_type1 <- matrix(0, n / 2, K)
  Z_type2 <- matrix(0, n / 2, K)
  
  # Randomly assign each node to one of the K blocks
  for (i in 1:nrow(Z_type1)) {
    Z_type1[i, sample(1:K, 1)] <- 1
  }
  
  for (i in 1:nrow(Z_type2)) {
    Z_type2[i, sample(1:K, 1)] <- 1
  }
  
  zero_matrix = matrix(0, n / 2, K)
  
  Z_type1 = cbind(Z_type1, zero_matrix)
  Z_type2 = cbind(zero_matrix, Z_type2)
  
  # Combine type-1 and type-2 membership matrices
  Z <- rbind(Z_type1, Z_type2)
  
  ##############################################
  # Generate adjacency matrix A
  A = gen_adj(Z, P)
  
  ####################################################################
  # Create a vector to store ground truth node information
  node_info <- matrix(0, n, 2)
  
  for (i in 1:n) {
    
    # Type membership
    node_info[i, 1] <- ifelse(which(Z[i, ] == 1) <= (T * K / 2), 1, 2)
    
    # Block membership
    if (which(Z[i, ] == 1) %in% c(1, 4)) {
      node_info[i, 2] <- 1
    } else if (which(Z[i, ] == 1) %in% c(2, 5)) {
      node_info[i, 2] <- 2
    } else if (which(Z[i, ] == 1) %in% c(3, 6)) {
      node_info[i, 2] <- 3
    }
  }
  
  #############################################################################
  ### covariate ######
  R = 3
  
  p_out_cov_type1 = 0.08
  p_out_cov_type2 = 0.05
  
  M_type1 <- as.matrix(
    p_out_cov_type1 * one_matrix_K + d * diag(1, K),
    nrow = T * K / 2, ncol = R
  )
  
  M_type2 <- as.matrix(
    p_out_cov_type2 * one_matrix_K + d * diag(1, K),
    nrow = T * K / 2, ncol = R
  )
  
  M = rbind(M_type1, M_type2)
  
  ### expected value of X given Z ###
  expected_X = Z %*% M
  
  ### generate covariate matrix X ###
  X = matrix(
    rbinom(n * R, 1, expected_X),
    nrow = n, ncol = R
  )
  
  ### calculating degrees of the nodes ###
  degrees = rowSums(A)
  
  ### calculating the regularizer tau ###
  tau = mean(degrees)
  
  ### regularized degree matrix ###
  D_tau_power_neg_half = diag(1 / sqrt(degrees + tau))
  
  ## Compute the regularized graph Laplacian L_tau
  L_tau <- D_tau_power_neg_half %*% A %*% D_tau_power_neg_half
  
  #################################################
  #### calculate L_tau_sq and X_sq
  L_tau_sq = crossprod(L_tau)
  XX_t = tcrossprod(X)
  
  ###################################################
  #### calculate optimal tuning parameter alpha ####
  alpha_optimal = (RSpectra::eigs_sym(L_tau_sq, k = 1, which = "LA")$values[1])/(RSpectra::eigs_sym(XX_t, k = 1, which = "LA")$values[1])
  
  ########## misclustering error ############
  number_of_misclassified_type1 = misclustering_error_changing_with_alpha(alpha=alpha_optimal, node_info, L_tau_sq, X, T, K, n)[[1]]
  number_of_misclassified_type2 = misclustering_error_changing_with_alpha(alpha=alpha_optimal, node_info, L_tau_sq, X, T, K, n)[[2]]
  
  return(list(number_of_misclassified_type1, number_of_misclassified_type2))
}
 
